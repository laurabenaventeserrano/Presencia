      "html": "<div class=\"ds-row\"><button class=\"ds-circ\" aria-label=\"Cerrar\"><svg width=\"20\" height=\"20\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"1.5\" stroke-linecap=\"round\"><path d=\"M6 6l12 12M18 6L6 18\"/></svg></button><button class=\"ds-circ ds-circ-sm\" aria-label=\"Quitar 5 minutos\" disabled><svg width=\"20\" height=\"20\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"1.5\" stroke-linecap=\"round\"><path d=\"M6 12h12\"/></svg></button><button class=\"ds-circ ds-circ-sm\" aria-label=\"Añadir 5 minutos\"><svg width=\"20\" height=\"20\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"1.5\" stroke-linecap=\"round\"><path d=\"M12 6v12M6 12h12\"/></svg></button></div>",
      "css": ":host{--fondo:#f2f4f8;--tarjeta:#fff;--pastilla:#f6f7fa;--suave:#f1f3f6;--tinta:#1f2430;--secundario:#666e80;--sobre-oscuro:#fff;font-family:Inter,system-ui,sans-serif;}.ds-row{display:flex;gap:8px;align-items:center;}.ds-circ{width:48px;height:48px;border:0;border-radius:4px;background:#f1f3f6;color:#1f2430;display:flex;align-items:center;justify-content:center;cursor:pointer;}.ds-circ-sm{width:44px;height:44px;}.ds-circ:disabled{opacity:.4;cursor:default;}.ds-circ:focus-visible{outline:2px solid #1f2430;outline-offset:3px;}"
