      "html": "<div class=\"ds-orbe\" role=\"img\" aria-label=\"Orbe\"><div class=\"ds-orbe-in\"><i style=\"left:14%;top:14%;background:#ee6f7a;animation-duration:26s\"></i><i style=\"left:22%;top:20%;background:#f5b77f;animation-duration:32s\"></i><i style=\"left:16%;top:24%;background:#fbd2c0;animation-duration:38s\"></i></div></div>",
      "css": ":host{--fondo:#f2f4f8;--tarjeta:#fff;--pastilla:#f6f7fa;--suave:#f1f3f6;--tinta:#1f2430;--secundario:#666e80;--sobre-oscuro:#fff;font-family:Inter,system-ui,sans-serif;}.ds-orbe{position:relative;width:160px;height:160px;border-radius:50%;}.ds-orbe-in{position:absolute;inset:0;border-radius:50%;filter:blur(25.6px);}.ds-orbe-in i{position:absolute;width:74%;height:74%;border-radius:50%;opacity:.95;animation:ds-drift ease-in-out infinite;}@keyframes ds-drift{0%,100%{transform:translate(-1.7%,-1.2%)}50%{transform:translate(1.4%,1%) scale(1.015)}}@media (prefers-reduced-motion:reduce){.ds-orbe-in i{animation:none}}"
