      "css": ":host{--fondo:#f2f4f8;--tarjeta:#fff;--pastilla:#f6f7fa;--suave:#f1f3f6;--tinta:#1f2430;--secundario:#666e80;--sobre-oscuro:#fff;font-family:Inter,system-ui,sans-serif;}.ds-campo{width:100%;max-width:480px;display:flex;align-items:center;gap:8px;background:#f6f7fa;border-radius:8px;padding:6px 6px 6px 20px;box-sizing:border-box;}.ds-campo input{flex:1;min-width:0;height:44px;border:0;background:transparent;font:400 16px Inter,system-ui,sans-serif;color:#1f2430;}.ds-campo input::placeholder{color:#666e80;}.ds-campo input:focus-visible{outline:2px solid #1f2430;outline-offset:6px;}.ds-enviar{width:48px;height:48px;flex:none;border:0;border-radius:4px;background:#1f2430;color:#fff;display:flex;align-items:center;justify-content:center;cursor:pointer;}.ds-enviar:focus-visible{outline:2px solid #1f2430;outline-offset:3px;}"
    },
